# Environment Configuration
# Copy this file to .env and fill in the values.
# .env is git-ignored and MUST NOT be committed.

# ===== App =====
APP_ENV=local
APP_PROFILE=tutorial

# ===== Tutorial Runtime =====
TUTORIAL_RUNTIME=mock
WEB_PROVIDER=mock
CATALOG_PROVIDER=mock
KNOWLEDGE_PROVIDER=mock
KNOWLEDGE_INDEX_PATH=.data/knowledge-index
KNOWLEDGE_COLLECTION=deepsearch-showcase-v1
KNOWLEDGE_EMBEDDING_PROVIDER=fastembed
KNOWLEDGE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ===== Server =====
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
# Host port; the container continues to listen on 3306.
MYSQL_HOST_PORT=3307
MYSQL_PORT=3307
MYSQL_USER=tutorial_reader
MYSQL_PASSWORD=tutorial_reader
MYSQL_DATABASE=research_copilot

# ===== LLM =====
MODEL_NAME=openai:gpt-4.1-mini
# MODEL_BASE_URL=
# MODEL_API_KEY=

# ===== External Services =====
# TAVILY_API_KEY=
# Showcase knowledge retrieval uses Qdrant Local + FastEmbed and no provider key.

# ===== Phase 4.5 Showcase (explicit opt-in) =====
# Keep this block commented for the default offline tutorial profile. Enable only
# the source capabilities you intend to use. MODEL_API_KEY is required for the
# Showcase model; TAVILY_API_KEY and MySQL settings are required only when their
# matching real capabilities are enabled. Knowledge uses the local index above.
# APP_PROFILE=showcase
# SHOWCASE_ENABLED=1
# SHOWCASE_SOURCES=web,mysql,knowledge,uploaded-file
# WEB_PROVIDER=tavily
# CATALOG_PROVIDER=mysql
# KNOWLEDGE_PROVIDER=qdrant-local
# PHASE45_REAL_SHOWCASE_SMOKE=1

# ===== Phase 3 Real Smoke (opt-in; never enabled by default) =====
# Real Provider/model smokes run only when BOTH the matching flag is set
# to '1' AND the relevant credential is already configured (TAVILY_API_KEY
# / MYSQL_PASSWORD for providers; MODEL_API_KEY for the model). Without
# both, the smoke suites skip with an explicit reason and never touch the
# network or read credential values.
# PHASE3_REAL_PROVIDER_SMOKE=1
# PHASE3_REAL_MODEL_SMOKE=1

# ===== Phase 4 Real Semantic Smoke (opt-in; never enabled by default) =====
# The P4-3 semantic support checker runs a real model ONLY when
# PHASE4_REAL_SEMANTIC_SMOKE=1 AND a model endpoint is configured (via the
# Phase 2 MODEL_NAME / MODEL_BASE_URL / MODEL_API_KEY above, or the
# PHASE4_REAL_SEMANTIC_* overrides below). Without the flag the real smoke
# suite skips with an explicit reason and the checker returns "skipped" --
# it never reads credential values or touches the network.
# PHASE4_REAL_SEMANTIC_SMOKE=1
# PHASE4_REAL_SEMANTIC_MODEL=openai:gpt-4.1-mini
# PHASE4_REAL_SEMANTIC_BASE_URL=
# PHASE4_REAL_SEMANTIC_API_KEY=
# PHASE4_REAL_SEMANTIC_TIMEOUT_SECONDS=30.0
