# Schema 5.0 local conversation runtime
# Copy to .env and fill only the provider credentials you use.

# Research model
MODEL_NAME=openai:gpt-4.1-mini
# MODEL_BASE_URL=
# MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60

# Optional real-time Web search
# TAVILY_API_KEY=

# Local knowledge index
KNOWLEDGE_INDEX_PATH=.data/knowledge-index-beginner-v2
KNOWLEDGE_COLLECTION=deepsearch-beginner-v2
KNOWLEDGE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
KNOWLEDGE_MIN_SCORE=0.40

# Local application state
DEEPSEARCH_SQLITE=.data/conversations.sqlite3
DEEPSEARCH_REPORT_ROOT=.data/reports
# 个人知识库（RAG 入库）固定位于 .data/user-uploads/，随用户分目录，无需配置键

# Sampling and retry governance (defaults: temperature 0.2, retries 2, top_p provider default)
# MODEL_TEMPERATURE=0.2
# MODEL_TOP_P=
# MODEL_MAX_RETRIES=2

# Reclaim stale running turns older than this many seconds (default 1800)
# TURN_STALE_SECONDS=<redacted>

# Verbose server-side diagnostics: DAG node trace + assembly degradation (default off)
# DEEPSEARCH_TRACE=<redacted>

# Citation validation via app/citations rule engine (default off)
# ENABLE_CITATION_VALIDATION=false

# Force provider json_object mode on every model call (B2 channel; parse-side noise stripping is always on)
# MODEL_STRUCTURED_OUTPUT=false
