# Environment Configuration
# Copy this file to .env and fill in the values.
# .env is git-ignored and MUST NOT be committed.

# ===== App =====
APP_ENV=local
APP_PROFILE=tutorial

# ===== Tutorial Runtime =====
TUTORIAL_RUNTIME=mock
WEB_PROVIDER=mock
CATALOG_PROVIDER=mock
KNOWLEDGE_PROVIDER=mock

# ===== Server =====
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
# Host port; the container continues to listen on 3306.
MYSQL_HOST_PORT=3307
MYSQL_PORT=3307
MYSQL_USER=tutorial_reader
MYSQL_PASSWORD=tutorial_reader
MYSQL_DATABASE=research_copilot

# ===== LLM =====
MODEL_NAME=openai:gpt-4.1-mini
# MODEL_BASE_URL=
# MODEL_API_KEY=

# ===== External Services =====
# TAVILY_API_KEY=
# RAGFLOW_API_KEY=
# RAGFLOW_BASE_URL=
