# Environment Configuration
# Copy this file to .env and fill in the values.
# .env is git-ignored and MUST NOT be committed.

# ===== App =====
APP_ENV=local

# ===== Server =====
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=research_copilot

